{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Registered contractor or admin account profile and company header settings.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 120
        },
        "phone": {
          "type": "string",
          "maxLength": 30
        },
        "designation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "companyName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "companyAddress": {
          "type": "string",
          "maxLength": 200
        },
        "companyMobile": {
          "type": "string",
          "maxLength": 60
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "displayName",
        "email",
        "designation",
        "companyName",
        "createdAt",
        "updatedAt"
      ]
    },
    "Worker": {
      "title": "Worker",
      "description": "Registered labourer or worker profile with daily wage rate and trade assignment.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "employeeId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "designation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "department": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "siteProject": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "dailyRate": {
          "type": "number"
        },
        "otHourlyRate": {
          "type": "number"
        },
        "defaultAllowance": {
          "type": "number"
        },
        "phone": {
          "type": "string",
          "maxLength": 30
        },
        "status": {
          "type": "string",
          "enum": ["active", "inactive"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "employeeId",
        "name",
        "designation",
        "department",
        "siteProject",
        "dailyRate",
        "otHourlyRate",
        "defaultAllowance",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "WorkLog": {
      "title": "WorkLog",
      "description": "Daily work entry recording attendance, In/Out time, OT hours, P.cash/expenses, and signature.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "workerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "workerName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "monthKey": {
          "type": "string",
          "minLength": 7,
          "maxLength": 7,
          "pattern": "^20[0-9]{2}-(0[1-9]|1[0-2])$"
        },
        "date": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^20[0-9]{2}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"
        },
        "siteProject": {
          "type": "string",
          "maxLength": 100
        },
        "dayUnits": {
          "type": "number"
        },
        "inTime": {
          "type": "string",
          "maxLength": 16
        },
        "outTime": {
          "type": "string",
          "maxLength": 16
        },
        "otHours": {
          "type": "number"
        },
        "hourlyRate": {
          "type": "number"
        },
        "dailyAllowance": {
          "type": "number"
        },
        "pCash": {
          "type": "number"
        },
        "signature": {
          "type": "string",
          "maxLength": 60
        },
        "notes": {
          "type": "string",
          "maxLength": 200
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "workerId",
        "workerName",
        "monthKey",
        "date",
        "dayUnits",
        "inTime",
        "outTime",
        "otHours",
        "pCash",
        "signature",
        "createdAt",
        "updatedAt"
      ]
    },
    "MonthlyAdjustment": {
      "title": "MonthlyAdjustment",
      "description": "Monthly allowances, extra advances, payment date, and remarks for a worker.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "workerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "monthKey": {
          "type": "string",
          "minLength": 7,
          "maxLength": 7,
          "pattern": "^20[0-9]{2}-(0[1-9]|1[0-2])$"
        },
        "allowances": {
          "type": "number"
        },
        "extraAdvance": {
          "type": "number"
        },
        "paymentDate": {
          "type": "string",
          "maxLength": 20
        },
        "remarks": {
          "type": "string",
          "maxLength": 300
        },
        "monthlyMemo": {
          "type": "string",
          "maxLength": 500
        },
        "department": {
          "type": "string",
          "maxLength": 60
        },
        "project": {
          "type": "string",
          "maxLength": 100
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "workerId",
        "monthKey",
        "allowances",
        "extraAdvance",
        "paymentDate",
        "createdAt",
        "updatedAt"
      ]
    },
    "SharedReport": {
      "title": "SharedReport",
      "description": "Published read-only Pay Sheet and Individual Salary Pay Sheet snapshot accessible via unguessable QR share token.",
      "type": "object",
      "properties": {
        "shareToken": {
          "type": "string",
          "minLength": 20,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "workerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "monthKey": {
          "type": "string",
          "minLength": 7,
          "maxLength": 7,
          "pattern": "^20[0-9]{2}-(0[1-9]|1[0-2])$"
        },
        "companyName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "companyAddress": {
          "type": "string",
          "maxLength": 200
        },
        "companyMobile": {
          "type": "string",
          "maxLength": 60
        },
        "employeeName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "employeeId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "designation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "department": {
          "type": "string",
          "maxLength": 60
        },
        "siteProject": {
          "type": "string",
          "maxLength": 100
        },
        "monthLabel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 30
        },
        "year": {
          "type": "string",
          "minLength": 4,
          "maxLength": 4
        },
        "paymentDate": {
          "type": "string",
          "maxLength": 20
        },
        "daysWorked": {
          "type": "number"
        },
        "dailyRate": {
          "type": "number"
        },
        "otHours": {
          "type": "number"
        },
        "basicSalary": {
          "type": "number"
        },
        "allowances": {
          "type": "number"
        },
        "overtimePay": {
          "type": "number"
        },
        "grossSalary": {
          "type": "number"
        },
        "totalAdvance": {
          "type": "number"
        },
        "netSalaryPayable": {
          "type": "number"
        },
        "remarks": {
          "type": "string",
          "maxLength": 300
        },
        "monthlyMemo": {
          "type": "string",
          "maxLength": 500
        },
        "attendanceLogs": {
          "type": "array"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "shareToken",
        "ownerId",
        "workerId",
        "monthKey",
        "companyName",
        "employeeName",
        "employeeId",
        "designation",
        "monthLabel",
        "year",
        "daysWorked",
        "dailyRate",
        "otHours",
        "basicSalary",
        "allowances",
        "overtimePay",
        "grossSalary",
        "totalAdvance",
        "netSalaryPayable",
        "attendanceLogs",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{uid}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private contractor/admin registration profile and company branding info."
    },
    "/workers/{workerId}": {
      "schema": { "$ref": "#/entities/Worker" },
      "description": "Workers/labourers registered by the authenticated contractor."
    },
    "/workLogs/{logId}": {
      "schema": { "$ref": "#/entities/WorkLog" },
      "description": "Daily attendance, In/Out, OT, Petty Cash/Expenses, and Signature records."
    },
    "/monthlyAdjustments/{adjustmentId}": {
      "schema": { "$ref": "#/entities/MonthlyAdjustment" },
      "description": "Monthly allowance, extra advance, and remarks per worker and month."
    },
    "/sharedReports/{shareToken}": {
      "schema": { "$ref": "#/entities/SharedReport" },
      "description": "Published read-only Pay Sheet & Salary Sheet snapshots fetched via QR token."
    }
  }
}
